{
  "name": "promptc",
  "version": "0.1.0",
  "description": "Prompt compiler proxy — preserve developer intent across any LLM",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "promptc": "dist/bin/promptc.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin/promptc.ts",
    "start": "node dist/bin/promptc.js",
    "dashboard:dev": "vite src/dashboard",
    "dashboard:build": "vite build src/dashboard"
  },
  "keywords": ["llm", "proxy", "prompt", "compiler", "anthropic", "openai"],
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.2.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.0",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "undici": "^7.3.0",
    "ollama": "^0.5.12",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "@types/node": "^22.13.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3"
  }
}
